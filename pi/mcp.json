{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--headless",
        "--isolated",
        "--executablePath",
        "/usr/bin/chromium",
        "--allowedUrlPattern",
        "http://localhost:*",
        "--allowedUrlPattern",
        "http://127.0.0.1:*",
        "--allowedUrlPattern",
        "about:*",
        "--redactNetworkHeaders"
      ],
      "exposure": "deferred",
      "description": "Headless Chromium on this machine, restricted to http://localhost and http://127.0.0.1, for DOM, console, network and performance checks of a project's dev server."
    }
  }
}
